# Copy to `.env` and adjust per environment.

# Canonical public origin (used for SEO canonical URLs, sitemap, hreflang).
NUXT_PUBLIC_SITE_URL=https://kainku.id

# Public contact details rendered on the site.
NUXT_PUBLIC_CONTACT_EMAIL=maulanayusupp@gmail.com

# Optional WhatsApp number in international format without "+" (e.g. 62812xxxxxxx).
# Leave empty to hide the WhatsApp call-to-action.
NUXT_PUBLIC_WHATSAPP=

# Server-only inbox that /api/contact submissions are addressed to.
NUXT_CONTACT_INBOX=maulanayusupp@gmail.com
